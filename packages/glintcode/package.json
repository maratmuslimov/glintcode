{
  "name": "glintcode",
  "version": "0.1.0",
  "description": "Glint: five scannable visual codes (Capsule, Orbit, Constellation, Halo, Contour) with one generator and one camera reader. No dependencies.",
  "license": "MIT",
  "author": "Marat Muslimov",
  "homepage": "https://glint.codes",
  "repository": { "type": "git", "url": "git+https://github.com/maratmuslimov/glint.git", "directory": "packages/glintcode" },
  "bugs": "https://github.com/maratmuslimov/glint/issues",
  "keywords": ["barcode", "qr", "visual-code", "scanner", "camera", "reed-solomon", "svg"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./iife": "./dist/glint.iife.js"
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --minify --clean && esbuild src/index.ts --bundle --format=iife --global-name=Glint --minify --outfile=dist/glint.iife.js",
    "test": "tsx --test test/*.test.ts",
    "stress": "tsx test/stress.ts",
    "vectors": "tsx test/vectors.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "playwright": "^1.56.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
